generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

//payment

enum TransactionType {
  Deposit
  Purchase
  Sale_Income
  Commission
  Withdraw
  Withdraw_Refund
  Salary
}

enum PaymentPurpose { 
    Wallet
    Charge
    Course
    Podcast
 }
enum PaymentStatus { 
     Pending
     Processing
     Success
     Failed
}

enum WithdrawStatus {
    Pending
    Paid
    Rejected
 }
 

 enum BankAccountStatus {
     Pending
     Approved
     Rejected 
  }

//
enum AccountType {
  User
  Teacher
  Author
  Admin
}

enum FormRequestStatus {
   Pending
   Approved
   Rejected
}

enum LikeType {
  Like
  DisLike
}




// ============ Person ============

model Person {
  id             String          @id @default(uuid())
  email          String?         @unique
  phoneNumber    String?         @unique
  password       String
  displayName    String?
  profileImage   String?
  personImage    personImage[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  role           AccountType     @default(User)

  teacherProfile TeacherProfile?
  course course[]
  authorProfile  AuthorProfile?
  adminProfile   AdminProfile?
  wallet         Wallet?
  otpCode        otpCode[]

  teacherFormRequest TeacherFormRequest[]
  adminFormRequest adminFormRequest[]

  deviceSessions DeviceSession[]
  ownedLinks     LinkedAccount[] @relation("Owner")
  linkedFrom     LinkedAccount[] @relation("Linked")

   favorite favoriteCourse[]

   Rating courseRating[]

   comment CommentCourse[]
   reply   ReplyCourseComment[]
   commentLike LikeCommentCourse[]
   replyLike   LikeReplyCommentCourse[]

   bankAccount BankAccount[]
   payments    Payment[]
   purchases   Purchase[]

}

// ============ Session ============

model DeviceSession {
  id                  String               @id @default(uuid())
  deviceId            String
  personId            String
  refreshToken        String?              
  refreshTokenExpiresAt DateTime?
  updatedAt           DateTime             @updatedAt
  person              Person               @relation(fields: [personId], references: [id], onDelete: Cascade)
  linkedAccountTokens LinkedAccountToken[]

  @@unique([deviceId, personId])
}


// ============ LinkedAccount ============

model LinkedAccount {
  id        String   @id @default(uuid())
  personId  String
  linkedId  String
  person    Person   @relation("Owner", fields: [personId], references: [id])
  linked    Person   @relation("Linked", fields: [linkedId], references: [id])
  createdAt DateTime @default(now())

  linkedAccountTokens LinkedAccountToken[]

  @@unique([personId, linkedId])
}

// ============ LinkedAccountToken ============

model LinkedAccountToken {
  id                   String        @id @default(uuid())
  linkedAccountId      String  @unique
  deviceSessionId      String
  switchToken          String?      
  switchTokenExpiresAt DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  linkedAccount  LinkedAccount  @relation(fields: [linkedAccountId], references: [id], onDelete: Cascade)
  deviceSession  DeviceSession  @relation(fields: [deviceSessionId], references: [id], onDelete: Cascade)

  @@unique([linkedAccountId, deviceSessionId])
}

// ============ OTPCode ============

model otpCode {
  id        Int      @id @default(autoincrement())
  personId  String   
  otpCode   String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  person    Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
}

// ============ Profiles ============

model TeacherProfile {
  id              String   @id @default(uuid())
  personId        String   @unique
  bio             String?
  
  degree          String
  fieldOfwork     String
  experienceYears Int

  linkdinLink   String?
  
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  
  person          Person   @relation(fields: [personId], references: [id], onDelete: Cascade)

  
}

model AuthorProfile {
  id        String   @id @default(uuid())
  personId  String   @unique
  bio       String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  person    Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
}


model AdminProfile {
  id        String   @id @default(uuid())
  personId  String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  isFinance Boolean @default(false)   // if admin is for payment change it true;

  person    Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
}

// ============ Request_Form ============

model adminFormRequest {
   id        String   @id @default(uuid())
   personId  String   @unique
   phoneNumber String?
   email       String?
   createdAt DateTime @default(now())

   person Person @relation(fields: [personId],references: [id],onDelete: Cascade)

}

model TeacherFormRequest {
  id              String            @id @default(uuid())
  personId        String            
  fullName        String
  ID_Card         String
  resumeUrl       String
  fieldOfwork     String
  experienceYears Int
  AcceptRulesOfWebSite  Boolean
  degree          String
  birthDate       DateTime @db.Date
  
  status          FormRequestStatus @default(Pending)
  rejectionReason String?

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  person Person @relation(fields: [personId],references: [id],onDelete:Cascade)
}

// ============ Wallet and Payment ============

model Wallet {
  id        String   @id @default(uuid())
  balance   Int      @default(0)
  personId  String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  person    Person   @relation(fields: [personId], references: [id], onDelete: Cascade)

  transactions WalletTransaction[]
   withdraws WithdrawRequest[]
}

model WalletTransaction {
  id           String          @id @default(uuid())
  walletId     String
  amount       Int          // -Number = withdraw / +Number=deposit
  balanceAfter Int
  type         TransactionType
  description  String?
  createdAt    DateTime        @default(now())

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId, createdAt])
}

model WithdrawRequest {
  id            String         @id @default(uuid())
  walletId      String
  bankAccountId String
  amount        Int
  sheba         String         // sheba of bankcard
  status        WithdrawStatus @default(Pending)
  trackingCode  String?
  reviewedById  String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  wallet      Wallet      @relation(fields: [walletId], references: [id])
  bankAccount BankAccount @relation(fields: [bankAccountId], references: [id])
}

model BankAccount {
  id           String            @id @default(cuid())
  firstName    String
  lastName     String
  nationalCode String
  shebaNumber  String            @unique  
  phoneNumber  String
  status       BankAccountStatus @default(Pending)
  isDefault    Boolean           @default(false)

  personId     String
  person       Person            @relation(fields: [personId], references: [id])

  withdraws    WithdrawRequest[]

  createdAt    DateTime          @default(now())
  verifiedAt   DateTime?

  @@index([personId])
}

model Purchase {
  id            String   @id @default(uuid())
  buyerId       String
  courseId      String?
  podcastId     String?
  price         Int
  teacherShare  Int
  platformShare Int
  createdAt     DateTime @default(now())

  buyer Person @relation(fields: [buyerId], references: [id])
  course course? @relation(fields: [courseId],references: [id],onDelete: Cascade)

  @@unique([buyerId, courseId])
  @@unique([buyerId, podcastId])
}




model Payment {
  id        String         @id @default(uuid())
  personId  String
  amount    Int
  purpose   PaymentPurpose
  courseId  String?
  podcastId String?
  authority String?        @unique
  refId     String?
  cardPan   String?
  status    PaymentStatus  @default(Pending)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  person Person @relation(fields: [personId], references: [id])
}



// ============ course ============

model course {
      id     String     @id @default(uuid())
      title  String    
      description  String
      price       Int
      teacherName  String?
      courseCoverUrl String
      isPublished Boolean  @default(false)
      createdAt   DateTime @default(now())
      updatedAt   DateTime @updatedAt
      
      teacherId    String?
      teacher     Person?    @relation(fields: [teacherId], references: [id])

      purchasedCourse Purchase[]
  
      courseTopic  courseTopic[]
      courseImage courseImage[]
      category  categoryCourse[]
      favorite favoriteCourse[]

      rateAvg      Float @default(0)
      rateCount    Int   @default(0)
      Rating       courseRating[]

      comment CommentCourse[]

}   

model courseRating {
  id        String   @id @default(uuid())
  score     Int     
  courseId  String
  personId  String
  createdAt DateTime @default(now())

  course    course   @relation(fields: [courseId], references: [id],onDelete: Cascade)
  person    Person   @relation(fields: [personId], references: [id],onDelete: Cascade)

  @@unique([courseId, personId]) 
}

model CommentCourse {
  id        Int           @id @default(autoincrement())
  content   String
  courseId  String
  personId  String
  course    course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  person    Person        @relation(fields: [personId], references: [id], onDelete: Cascade)
  replies   ReplyCourseComment[]
  like      Int   @default(0)
  disLike   Int   @default(0)
  likes     LikeCommentCourse[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model ReplyCourseComment {
  id        Int         @id @default(autoincrement())
  content   String
  commentId Int
  personId  String
  comment   CommentCourse     @relation(fields: [commentId], references: [id], onDelete: Cascade)
  person    Person      @relation(fields: [personId], references: [id], onDelete: Cascade)
  like      Int   @default(0)
  disLike   Int   @default(0)
  likes     LikeReplyCommentCourse[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model LikeCommentCourse {
  id        Int      @id @default(autoincrement())
  type      LikeType
  commentId Int
  personId  String
  comment   CommentCourse  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  person    Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([commentId, personId])
}

model LikeReplyCommentCourse {
  id        Int      @id @default(autoincrement())
  type      LikeType
  replyId   Int
  personId  String
  reply     ReplyCourseComment   @relation(fields: [replyId], references: [id], onDelete: Cascade)
  person    Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([replyId, personId])
}


model courseTopic{
    id     Int     @id @default(autoincrement())
    courseId  String
    topicName  String

    courseLesson courseLesson[]

    course  course @relation(fields: [courseId],references: [id],onDelete: Cascade)
    
}

model courseLesson {
    id     String     @id @default(uuid())
    courseTopicId  Int
    lessonName  String
    videoUrl   String

    courseTopic  courseTopic @relation(fields: [courseTopicId],references: [id],onDelete: Cascade)
} 

model courseImage{
   id Int @id @default(autoincrement())
   url String
   courseId String
   course course @relation(fields: [courseId], references: [id],onDelete: Cascade)
}

model categoryCourse{
   id Int @id @default(autoincrement())
   name String @unique
   courses course[]

}



model favoriteCourse{
   id Int @id @default(autoincrement())
   personId String  
   courseId String 

   person Person @relation(fields: [personId],references: [id],onDelete: Cascade)
   course course @relation(fields: [courseId],references: [id],onDelete:Cascade)

   @@unique([personId,courseId])
}




// ============ Images ============

model personImage {
  id       String @id @default(uuid())
  url      String
  personId String

  person   Person @relation(fields: [personId], references: [id], onDelete: Cascade)
}
